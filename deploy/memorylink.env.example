# Optional overrides for memorylink.service. Installed as
# /etc/memorylink.env with mode 0640 root:memorylink.
#
# systemd reads this file after the unit's Environment= lines, so values here
# take precedence. Keep this path in sync with ReadWritePaths= in the unit if
# you change it.
MEMORYLINK_DATA_DIR=/var/lib/memorylink

# The GitHub repository the "Download latest build" button reads artifacts
# from. Defaults to rsnel/memorylink-app when unset.
#MEMORYLINK_GITHUB_REPO=rsnel/memorylink-app
